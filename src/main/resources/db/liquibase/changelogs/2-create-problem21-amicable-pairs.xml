<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="1" author="yaolinh">
        <createTable tableName="problem21_amicable_pairs">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="problem21_id" type="varchar(36)">
                <constraints foreignKeyName="fk_amicable_pair_problem21" references="problem21(id)" nullable="false"/>
            </column>
            <column name="amicableA" type="int">
                <constraints nullable="false" />
            </column>
            <column name="amicableB" type="int">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP" />
            <column name="update_at" type="timestamp" />
            <column name="create_by" type="varchar(255)" defaultValue="Yaolinh"/>
            <column name="update_by" type="varchar(255)" defaultValue="Yaolinh"/>
        </createTable>
    </changeSet>

</databaseChangeLog>